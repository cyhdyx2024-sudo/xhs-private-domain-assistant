# ===== 安全默认值说明 =====
# XHS_PRODUCT_MODE 默认为 1（安全默认）：
#   - 强制 BYOK：每次 /reply 必须由扩展显式传 X-Model-Key / X-Model-Base-Url / X-Model-Name
#   - 服务端不会回退到 OPENCODEX_* 内部凭据，避免本地 Bridge 被任意网页当作开放代理
# 仅在本机开发、且明确需要"服务端自带模型"时才设为 0：
# XHS_PRODUCT_MODE=0
OPENCODEX_URL=http://127.0.0.1:10100/v1/chat/completions
OPENCODEX_API_KEY=在这里填上游兼容 OpenAI API 的 Key
OPENCODEX_MODEL=google-antigravity/gemini-3.7-flash
# 模型转发仅允许这些 HTTPS 域名，防止服务端请求伪造（SSRF）。
XHS_ALLOWED_MODEL_HOSTS=api.openai.com,api.deepseek.com,dashscope.aliyuncs.com,open.bigmodel.cn,api.moonshot.cn,api.siliconflow.cn,ark.cn-beijing.volces.com,api.minimax.chat,openrouter.ai

# 不填时默认保存到 Agent 目录下的 data/xhs_reply_feedback.sqlite3
# XHS_FEEDBACK_DB=/home/jay/reception-agent-v11/data/xhs_reply_feedback.sqlite3

# ===== 线索警报与经营日报 =====
# 群机器人 Webhook（飞书 open.feishu.cn/... 或 企微 qyapi.weixin.qq.com/...）。
# 租户在 Studio 里配置的地址优先；此处为未配置租户的全局兜底。
# XHS_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 日报推送时间（UTC 小时，默认 13 = 北京时间 21:00）
# XHS_REPORT_HOUR=13
