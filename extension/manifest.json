{
  "manifest_version": 3,
  "name": "小红书私信智能副驾 (XHS Copilot Pro)",
  "version": "1.1.0",
  "description": "适配专业号客服工作台的上下文私信副驾，支持多模型、业务知识库、人工确认与线索捕获",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "小红书私信智能顾问",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://creator.xiaohongshu.com/*",
    "*://pro.xiaohongshu.com/*",
    "*://business.xiaohongshu.com/*",
    "*://customer.xiaohongshu.com/*",
    "*://qianfan.xiaohongshu.com/*",
    "*://www.xiaohongshu.com/*",
    "*://edith.xiaohongshu.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://creator.xiaohongshu.com/*",
        "*://pro.xiaohongshu.com/*",
        "*://business.xiaohongshu.com/*",
        "*://customer.xiaohongshu.com/*",
        "*://qianfan.xiaohongshu.com/*",
        "*://www.xiaohongshu.com/*",
        "*://edith.xiaohongshu.com/*"
      ],
      "js": [
        "safety.js",
        "content.js",
        "comment-copilot.js"
      ],
      "css": [
        "floating-dock.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
